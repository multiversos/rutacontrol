# Nombre visible de la aplicacion
NEXT_PUBLIC_APP_NAME=RutaControl

# Zona horaria de negocio usada para cierres y reportes
BUSINESS_TIMEZONE=America/Caracas

# URL base publica de la app para enlaces y deploy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase publico
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional durante la transicion de claves de Supabase.
# Si existe, la app dara prioridad a esta clave sobre la anon.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. No se usa para saltarse RLS en la UI de Sprint 1.
SUPABASE_SERVICE_ROLE_KEY=

# Android/Capacitor. Debe incluir /mobile.
CAPACITOR_SERVER_URL=https://rutacontrol.vercel.app/mobile

# Firma opcional para release interno Android. No guardar secretos reales en git.
RUTACONTROL_RELEASE_STORE_FILE=
RUTACONTROL_RELEASE_STORE_PASSWORD=
RUTACONTROL_RELEASE_KEY_ALIAS=
RUTACONTROL_RELEASE_KEY_PASSWORD=
RUTACONTROL_VERSION_NAME=0.6.0-internal.1
RUTACONTROL_VERSION_CODE=60001
