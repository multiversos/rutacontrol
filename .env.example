# Nombre visible de la aplicacion
NEXT_PUBLIC_APP_NAME=RutaControl

# Zona horaria de negocio usada para cierres y reportes
BUSINESS_TIMEZONE=America/Caracas

# URL base publica de la app para enlaces y deploy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase publico
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional durante la transicion de claves de Supabase.
# Si existe, la app dara prioridad a esta clave sobre la anon.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. No se usa para saltarse RLS en la UI de Sprint 1.
SUPABASE_SERVICE_ROLE_KEY=
